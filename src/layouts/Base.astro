---
import "../styles/ferrite.css";

interface Props {
    title: string;
    description?: string;
    /** Which nav item is the current page (highlights it; `home` marks the logo). */
    active?: "home" | "docs" | "api" | "download";
}

const { title, description, active } = Astro.props;
const cur = (key: Props["active"]) => (active === key ? "page" : undefined);

const FAVICON =
    "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23171411'/%3E%3Cpath d='M18 12h29v9H28v8h16v9H28v14H18Z' fill='%23ff6a38'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <meta name="theme-color" content="#0e0c0a" />
        <link rel="icon" href={FAVICON} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <nav class="site-nav" aria-label="Primary navigation">
            <div class="nav-inner">
                <a
                    class="brand display"
                    href={active === "home" ? "#top" : "index.html"}
                    aria-label="Ferrite home"
                    aria-current={cur("home")}
                >
                    <span class="mark" aria-hidden="true">
                        <svg viewBox="0 0 64 64" aria-hidden="true">
                            <rect width="64" height="64" rx="14" fill="#1c1814"
                            ></rect>
                            <rect
                                x="0.5"
                                y="0.5"
                                width="63"
                                height="63"
                                rx="13.5"
                                fill="none"
                                stroke="#2c2620"></rect>
                            <path
                                d="M18 12h29v9H28v8h16v9H28v14H18Z"
                                fill="#ff6a38"></path>
                        </svg>
                    </span>
                    <span>ferrite</span>
                </a>
                <div class="nav-links">
                    <a href={active === "home" ? "#panel" : "index.html#panel"}>Panel</a>
                    <a href="docs.html" aria-current={cur("docs")}>Docs</a>
                    <a href="api.html" aria-current={cur("api")}>API</a>
                    <a href="download.html#releases">Changelog</a>
                    <a href="https://github.com/syntlyx/ferrite-server">GitHub</a>
                    <a
                        href="download.html"
                        class="button button-primary button-mini"
                        aria-current={cur("download")}>Download</a
                    >
                </div>
            </div>
        </nav>

        <slot />

        <footer>
            <div class="footer-inner">
                <a
                    class="brand display"
                    href="index.html"
                    aria-label="Ferrite home"
                >
                    <span class="mark" aria-hidden="true">
                        <svg viewBox="0 0 64 64" aria-hidden="true">
                            <rect width="64" height="64" rx="14" fill="#1c1814"
                            ></rect>
                            <rect
                                x="0.5"
                                y="0.5"
                                width="63"
                                height="63"
                                rx="13.5"
                                fill="none"
                                stroke="#2c2620"></rect>
                            <path
                                d="M18 12h29v9H28v8h16v9H28v14H18Z"
                                fill="#ff6a38"></path>
                        </svg>
                    </span>
                    <span>ferrite</span>
                </a>
                <nav class="footer-links" aria-label="Footer">
                    <a href="docs.html">Docs</a>
                    <a href="api.html">API</a>
                    <a href="download.html">Download</a>
                    <a href="download.html#releases">Changelog</a>
                    <a href="https://github.com/syntlyx/ferrite-server">Server source</a>
                    <a href="https://github.com/syntlyx/ferrite-web">Panel source</a>
                </nav>
                <span class="footer-note">MIT licence · no account, no telemetry</span>
            </div>
        </footer>
    </body>
</html>
